{
  "name": "skylight-axi",
  "version": "0.1.0",
  "description": "Agent-ergonomic CLI (AXI) for Skylight Calendar: events, chores, lists, meals, rewards.",
  "type": "module",
  "bin": {
    "skylight-axi": "dist/bin/skylight-axi.js"
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx bin/skylight-axi.ts",
    "gen:skill": "tsx scripts/gen-skill.ts",
    "check:skill": "tsx scripts/gen-skill.ts --check"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "axi-sdk-js": "^0.1.13",
    "skylight-mcp": "^1.4.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
